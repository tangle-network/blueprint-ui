{
  "name": "@tangle-network/blueprint-ui",
  "version": "0.6.0",
  "description": "Shared blueprint UI components, hooks, and contract utilities for Tangle Network apps",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tangle-network/blueprint-ui.git"
  },
  "homepage": "https://github.com/tangle-network/blueprint-ui",
  "bugs": {
    "url": "https://github.com/tangle-network/blueprint-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "package.json",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components.js",
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./preset": {
      "import": "./dist/preset.js",
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./wallet": {
      "import": "./dist/wallet/index.js",
      "types": "./dist/wallet/index.d.ts",
      "default": "./dist/wallet/index.js"
    },
    "./iframe": {
      "import": "./dist/iframe/index.js",
      "types": "./dist/iframe/index.d.ts",
      "default": "./dist/iframe/index.js"
    },
    "./iframe/testing": {
      "import": "./dist/iframe/testing-index.js",
      "types": "./dist/iframe/testing-index.d.ts",
      "default": "./dist/iframe/testing-index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-styles.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@nanostores/react": "^1.0.0 || ^2.0.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@tanstack/react-query": "^5.0.0",
    "blo": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^12.0.0 || ^13.0.0",
    "nanostores": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0 || ^8.0.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.2.0",
    "viem": "^2.31.0",
    "wagmi": "^3.3.0"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@nanostores/react": "^2.0.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "blo": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "jsdom": "^30.1.1",
    "nanostores": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "unocss": "^66.10.5",
    "unocss-preset-animations": "^1.3.0",
    "viem": "^2.56.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wagmi": "^3.7.7"
  },
  "packageManager": "pnpm@12.6.0"
}
